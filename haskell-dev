#!/usr/bin/env python3
"""The development loop of a Haskell package: build, test and docs, fast.

    haskell-dev build              build the package and its tests
    haskell-dev test               build, then run every test
    haskell-dev test Psbt Block    run the specs whose module name has a word
    haskell-dev test --match "/Haskoin.Block/asert/"
    haskell-dev docs               build the Haddock documentation

It works on the package of the git repository of the current directory, so
one copy serves every package. It expects the layout of the packages of
jprupp on GitHub: one package at the root of the repository, built with
Stack, with the library in src, the programs in app, and the tests in one
hspec suite named spec.

This script is for work on the code. It changes nothing in what is
released: `stack build`, `stack test` and `stack bench` still build the
package with optimisation.

Why each command is faster than the plain one, with the timings of
haskoin-core:

build   compiles without optimisation, eight modules at a time. A clean
        build takes about 30 seconds this way, and about 170 with
        `stack build --test`. Use this command every time: after a plain
        `stack build` in the same folder, either command compiles
        everything again, since the flags changed.

test    runs the test binary as several processes at once, each on its
        share of the specs. One process runs one test at a time, and takes
        about 30 seconds for all of them. Eight processes take 5 to 10.
        Each process gets a temporary folder of its own.

docs    builds the documentation in a work folder of its own,
        .stack-work-docs, in about 15 seconds. `stack haddock` in the
        usual folder compiles the whole library again, and so does the
        next `stack build` after it. Then it checks the documentation, and
        fails when the check finds something: see `check_docs`.

Never time the code with this build: a benchmark needs optimisation.

What sets a package apart is in haskell-dev.toml, at the root of its
repository. The file is optional, and so is each of its settings: see
`SETTINGS`.
"""

import argparse
import collections
import fnmatch
import glob
import html.parser
import json
import os
import queue
import random
import re
import shutil
import subprocess
import sys
import tempfile
import threading
import time
import tomllib
import urllib.parse

# Modules compiled at once, and test processes run at once, at most
MOST_JOBS = 8

# The flags of a development build. They must be the same on every build,
# or stack compiles everything again.
FAST_BUILD = ["--fast", "--ghc-options=-j%d" % min(MOST_JOBS, os.cpu_count() or 1)]

# The work folder of the documentation, apart from the one of the builds
DOCS_WORK_DIR = ".stack-work-docs"

# The folders of the modules whose comments are checked: the library and
# the programs. A package without one of them is fine.
SOURCE_DIRS = ("src", "app")

# The test suite of the package, which is also the name of its binary
TEST_SUITE = "spec"

# The file of the settings of a package, at the root of its repository
SETTINGS_FILE = "haskell-dev.toml"

# The settings, each a list of patterns for the names of modules, where *
# stands for any text: "Haskoin.Block" is that one module, "*.Regtest.*"
# every module with Regtest inside its name. A setting left out is empty.
SETTINGS = {
    # The spec modules that take most of the time of the tests. Each of
    # their groups is run apart, so that the processes share them evenly,
    # and so the groups of such a module must be able to run at once.
    # Every other spec module is run whole.
    "slow-specs": "slow_specs",
    # The modules whose declarations a tool generates, as persistent does
    # for a schema. Haddock has no place in a page for some of the names
    # they refer to, and says so for each one: nothing in the sources can
    # change that, so the check leaves those warnings out.
    "generated-modules": "generated_modules",
}
Settings = collections.namedtuple("Settings", sorted(SETTINGS.values()))

# The start of the names GHC generates for a type that derives Generic.
# Haddock has no place in a page for them either, in any package.
GENERATED_NAME = "Rep_"

# How long each share of the specs took last time, kept to start the
# longest ones first. It sits in the work folder, which git ignores.
TIMES_FILE = os.path.join(".stack-work", "dev-test-times.json")

# A line of the listing that is a test: it ends with its result
TEST_LINE = re.compile(r"\[.\](?: \(\d+ms\))?$")
# The last line of a run of the test binary
SUMMARY_LINE = re.compile(r"^(\d+) examples?, (\d+) failures?(?:, (\d+) pending)?")
# The lines of the listing that start at the margin and are no spec module
NOT_A_MODULE = re.compile(r"^(Finished in|Randomized with|Failures:|\d+ examples?,)")


def main():
    args = arguments()
    os.chdir(repository_root())
    settings = read_settings()
    if args.command == "build":
        sys.exit(build())
    if args.command == "docs":
        sys.exit(docs(settings))
    built = build()
    if built != 0:
        sys.exit(built)
    spec = test_binary()
    seed = args.seed if args.seed is not None else random.randrange(1, 2**31)
    if args.match:
        sys.exit(run_in_one_process(spec, args.match, seed))
    sys.exit(test(spec, settings.slow_specs, args.names, args.jobs, seed))


def arguments():
    """The command of this run and its options"""
    parser = argparse.ArgumentParser(
        description="Build, test and document the Haskell package of this git repository, fast."
    )
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("build", help="build the package and its tests, without optimisation")
    test = commands.add_parser("test", help="build, then run the tests in several processes")
    test.add_argument(
        "names",
        nargs="*",
        metavar="NAME",
        help="run only the specs whose module name has this word, such as Psbt or Crypto.Keys",
    )
    test.add_argument(
        "-j",
        "--jobs",
        type=int,
        default=min(MOST_JOBS, os.cpu_count() or 1),
        help="how many processes to run at once (default: %(default)s)",
    )
    test.add_argument(
        "--seed",
        type=int,
        default=None,
        help="the seed of the random tests, to run a failure again",
    )
    test.add_argument(
        "--match",
        action="append",
        default=[],
        metavar="PATTERN",
        help="run the tests of this path in one process, as the --match of the test binary",
    )
    commands.add_parser("docs", help="build the Haddock documentation in its own work folder, and check it")
    return parser.parse_args()


def repository_root():
    """The root of the git repository of the current directory, which holds the Stack project"""
    found = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if found.returncode != 0:
        sys.exit("haskell-dev: not in a git repository")
    root = found.stdout.strip()
    if not os.path.exists(os.path.join(root, "stack.yaml")):
        sys.exit("haskell-dev: no stack.yaml in %s" % root)
    return root


# The settings of a package


def read_settings():
    """The settings of the package, or the reason the file is wrong, as the end of the run"""
    try:
        with open(SETTINGS_FILE, "rb") as handle:
            return settings_of(tomllib.load(handle))
    except FileNotFoundError:
        return settings_of({})
    except ValueError as wrong:  # tomllib raises one too, for text that is no TOML
        sys.exit("haskell-dev: %s: %s" % (SETTINGS_FILE, wrong))


def settings_of(given):
    """The settings out of the content of the file. A name this script does not know is a mistake."""
    unknown = sorted(set(given) - set(SETTINGS))
    if unknown:
        raise ValueError("no setting is named %s: there are %s" % (", ".join(unknown), ", ".join(SETTINGS)))
    for name, patterns in given.items():
        if not isinstance(patterns, list) or not all(isinstance(pattern, str) for pattern in patterns):
            raise ValueError('%s must be a list of texts, as ["Haskoin.Block", "*.Regtest.*"]' % name)
    return Settings(**{field: tuple(given.get(name, ())) for name, field in SETTINGS.items()})


def matches_any(module, patterns):
    """Whether the name of the module fits one of the patterns of a setting"""
    return any(fnmatch.fnmatchcase(module, pattern) for pattern in patterns)


# build


def build():
    """Build the package and its tests with the development flags, and give the exit code of stack"""
    return subprocess.call(["stack", "build"] + FAST_BUILD + ["--test", "--no-run-tests"])


# docs


def docs(settings):
    """Build the documentation, show what Haddock prints, then check it.

    Haddock is made to run on every module each time, which takes about 15
    seconds on haskoin-core. Without that it runs only on what changed, or
    not at all, and its warnings about the other modules are missing from
    the check.
    """
    stack = subprocess.Popen(
        ["stack", "--work-dir", DOCS_WORK_DIR, "haddock", "--no-haddock-deps", "--force-dirty"],
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        errors="replace",
    )
    printed = []
    for line in stack.stdout:
        sys.stdout.write(line)
        printed.append(line.rstrip("\n"))
    code = stack.wait()
    return code if code != 0 else check_docs(printed, settings.generated_modules)


def check_docs(printed, generated):
    """Report what is wrong in the documentation of the package, and give 1 if anything is.

    Haddock prints hundreds of lines about the names of the dependencies,
    whose documentation is not built here, and about generated names. A
    warning about a comment of the package is lost among them. Haddock
    also says nothing of three mistakes in a comment, which this check
    finds in the pages and in the sources:

    * a link to a name its module does not export, written with the name
      of the module: the page has a link that leads nowhere;
    * t'Name' or v'Name' written right after a character that is no
      space, as in (t'Name'): the page shows the letter;
    * a path written with plain slashes, as m/44'/0': the page shows the
      text between two slashes in italics, without the slashes.
    """
    sources = source_files()
    problems = (
        haddock_warnings(printed, set(sources), generated)
        + broken_links(pages_of(sources), imported_modules(sources))
        + bare_slashes(sources)
    )
    print()
    if not problems:
        print("Documentation check: nothing to report.")
        return 0
    print("Documentation check: %d to fix." % len(problems))
    for problem in problems:
        print("  " + problem)
    return 1


def source_files():
    """The file of each module of the library and of the programs, by the name of the module"""
    return {
        os.path.relpath(source, folder)[: -len(".hs")].replace(os.sep, "."): source
        for folder in SOURCE_DIRS
        for source in glob.glob(os.path.join(folder, "**", "*.hs"), recursive=True)
    }


def haddock_warnings(printed, own, generated):
    """The warnings of Haddock about the comments of the package, each with its module.

    `own` holds the modules of the package. A warning about a name or a
    module of a dependency is left out: its documentation is not built
    here, so Haddock cannot find it, and nothing is wrong with the comment.
    So are the warnings of the modules that fit `generated`.

    Haddock prints a warning about a link before the line that counts the
    documented declarations of the module.
    """
    warnings, waiting = [], []
    for at, line in enumerate(printed):
        link = re.match(r"Warning: ('.*' is (?:out of scope|ambiguous))", line)
        module = re.match(r"\s*\d+% \(.*\) in '(.*)'", line)
        exported = re.match(r"Warning: (\S+): (Could not find documentation for exported module: (\S+))", line)
        missing = re.match(r"Warning: (\S+): could not find link destinations for:", line)
        if link:
            waiting.append(link.group(1))
        elif module:
            warnings += ["%s: %s" % (module.group(1), warning) for warning in waiting]
            waiting = []
        elif exported and exported.group(3) in own:
            warnings.append("%s: %s" % exported.group(1, 2))
        elif missing and not matches_any(missing.group(1), generated):
            warnings += [
                "%s: no link destination for %s, which its module does not export" % (missing.group(1), name)
                for name in names_listed_after(printed, at)
                if is_name_of(name, own) and not name.rpartition(".")[2].startswith(GENERATED_NAME)
            ]
    return warnings


def names_listed_after(printed, at):
    """The names Haddock lists below the line at this place, one on each line"""
    names = []
    for line in printed[at + 1 :]:
        if not line.startswith("\t- "):
            break
        names.append(line[3:].strip())
    return names


def is_name_of(name, modules):
    """Whether a name written with its module, as Haskoin.Block.Block, is of one of these modules.

    The name is not cut at its last dot: an operator can have a dot too.
    """
    return any(name.startswith(module + ".") for module in modules)


class CommentLinks(html.parser.HTMLParser):
    """The links a page has in the text of its comments, and the anchors it has.

    The text of a comment is in a div of the class doc. The links of the
    signatures are outside: Haddock makes those from names it resolved.
    """

    def __init__(self):
        super().__init__()
        self.anchors, self.links, self.stray = set(), [], []
        self.depth, self.before = 0, ""

    def handle_starttag(self, tag, attributes):
        attributes = dict(attributes)
        if attributes.get("id"):
            self.anchors.add(attributes["id"])
        if tag == "div" and (self.depth or "doc" in (attributes.get("class") or "").split()):
            self.depth += 1
        if tag == "a" and self.depth and attributes.get("href"):
            self.links.append(attributes["href"])
            if re.search(r"#[tv]:", attributes["href"]) and re.search(r"\S[tv]$", self.before):
                self.stray.append(self.before[-12:])
        # Haddock puts the link of a name in a code tag: the text before
        # that tag is the text before the link
        if tag != "code":
            self.before = ""

    def handle_endtag(self, tag):
        if tag == "div" and self.depth:
            self.depth -= 1
        self.before = ""

    def handle_data(self, data):
        self.before = data


def page_of(module):
    """The name of the file of the page Haddock makes for a module"""
    return module.replace(".", "-") + ".html"


def module_of(page):
    """The module that the page of this file name is about"""
    return page[: -len(".html")].replace("-", ".")


def pages_of(sources):
    """The page Haddock made for each module of the sources, read, by the name of its file.

    Only these pages are read: the folder keeps the page of a module that
    is gone. A module that Haddock made no page for is left out.
    """
    dist = subprocess.check_output(["stack", "--work-dir", DOCS_WORK_DIR, "path", "--dist-dir"], text=True).strip()
    pages = {}
    for module in sources:
        for file in glob.glob(os.path.join(dist, "doc", "html", "*", page_of(module))):
            page = CommentLinks()
            with open(file, errors="replace") as text:
                page.feed(text.read())
            pages[page_of(module)] = page
    return pages


def imported_modules(sources):
    """The modules that the sources import"""
    modules = set()
    for source in sources.values():
        with open(source) as text:
            modules.update(re.findall(r"^import\s+(?:qualified\s+)?([\w.]+)", text.read(), re.MULTILINE))
    return modules


def broken_links(pages, known):
    """The links of the comments that lead nowhere, and the letters of a namespace left in the text.

    `known` holds the modules that the sources import. A link to a module
    of a dependency leads nowhere here, where the documentation of the
    dependencies is not built, and leads to its page on Hackage. It is
    taken as right when a source imports that module.
    """
    problems = []
    for name, page in sorted(pages.items()):
        for link in page.links:
            file, _, anchor = link.partition("#")
            target = file or name
            if "://" in link or link.startswith(("../", "mailto:")):
                continue
            if target not in pages and module_of(file) not in known:
                problems.append(
                    "%s: a link to %s, which is no page: a word in double quotes is a link to a module"
                    % (module_of(name), link)
                )
            elif target in pages and anchor and urllib.parse.unquote(anchor) not in pages[target].anchors:
                problems.append("%s: a link to %s, which that page does not have" % (module_of(name), link))
        problems += [
            '%s: a namespace letter shows before a link, after "%s"' % (module_of(name), text)
            for text in page.stray
        ]
    return problems


def bare_slashes(sources):
    """The lines of the Haddock comments of the sources with a slash that is not escaped"""
    problems = []
    for source in sorted(sources.values()):
        with open(source) as text:
            lines = text.read().split("\n")
        problems += [
            "%s:%d: a slash to write \\/ in a Haddock comment" % (source, number)
            for number in lines_with_bare_slash(lines)
        ]
    return problems


def lines_with_bare_slash(lines):
    """The numbers of the lines of a source with a slash that is not escaped, in a Haddock comment.

    Haddock reads the text between two slashes as italics. A slash is
    written \\/ in a comment. A slash of a URL stays, and so does a word
    put in italics on purpose, /as this one/.
    """
    numbers = []
    in_haddock = False
    for number, line in enumerate(lines, 1):
        starts = re.match(r"\s*[{|=,(]?\s*-- [|^*$]", line)
        if not (line.lstrip().startswith("--") or starts):
            in_haddock = False
            continue
        in_haddock = in_haddock or bool(starts)
        comment = line.split("--", 1)[1]
        if not in_haddock or comment.lstrip().startswith(">"):
            continue
        words = [
            word
            for word in comment.split()
            if "://" not in word and not re.match(r"/[A-Za-z]+/[.,;:]?$", word)
        ]
        if any(re.search(r"(?<!\\)/", word) for word in words):
            numbers.append(number)
    return numbers


# test


def test_binary():
    """The test binary of the build. Run from the root of the repository, it finds the files of the package."""
    dist = subprocess.check_output(["stack", "path", "--dist-dir"], text=True).strip()
    spec = os.path.join(dist, "build", TEST_SUITE, TEST_SUITE)
    if not os.path.exists(spec):
        sys.exit("haskell-dev: no test binary at %s: the tests must be one suite named %s" % (spec, TEST_SUITE))
    return spec


def run_in_one_process(spec, patterns, seed):
    """Run the tests of the paths given in one process, with its usual output"""
    matches = [word for pattern in patterns for word in ("--match", pattern)]
    return subprocess.call([spec, "--seed", str(seed)] + matches)


def test(spec, slow, names, jobs, seed):
    """Run the specs of the modules the names pick, or every one, in several processes, and report as one run.

    The exit code is 0 when every test passed and every test of the
    listing ran.
    """
    # The test binary lists its tests without running them
    listing = subprocess.run([spec, "--dry-run"], capture_output=True, text=True).stdout
    shares = longest_first(shares_of(listing, names, slow), last_times())
    if not shares:
        print("No spec module has %s in its name" % " or ".join(names) if names else "The test binary has no test")
        return 1
    jobs = max(1, min(jobs, len(shares)))
    started = time.time()
    runs = run_in_processes(spec, shares, jobs, seed)
    remember_times(runs)
    return report(runs, sum(share.tests for share in shares), time.time() - started, jobs, seed)


# A share of the specs, run by one process: a spec module, or one group of
# a module. `tests` is how many tests the listing counts in it.
Share = collections.namedtuple("Share", ["pattern", "tests"])

# What became of a share: how long its process ran, its exit code, and all
# that it printed
Run = collections.namedtuple("Run", ["share", "seconds", "code", "output"])


def shares_of(listing, names, slow):
    """The shares to run: every one, or those of the modules the names pick.

    The listing has a module at the margin, its groups two spaces in, and
    its tests below, each with its result at the end of its line. `slow`
    holds the patterns of the modules to run one group at a time.
    """
    tests = collections.OrderedDict()  # (module, group) -> number of tests
    loose = set()  # modules with a test outside any group
    module = group = None
    for line in listing.splitlines():
        if not line.strip() or NOT_A_MODULE.match(line):
            continue
        if not line.startswith(" "):
            module, group = line.strip(), None
        elif TEST_LINE.search(line):
            if group is None:
                loose.add(module)
            tests[(module, group)] = tests.get((module, group), 0) + 1
        elif re.match(r"^  \S", line):
            group = line.strip()
    # A pattern names a group by its path. A slash in the name of a group,
    # as in "Read/Show Encoding", does no harm: the test binary looks for
    # the pattern as a piece of the path. A module with a test outside any
    # group is run whole, since no pattern of a group would run that test.
    counts = collections.OrderedDict()  # pattern -> number of tests
    for (module, group), count in tests.items():
        if names and not any(name in module for name in names):
            continue
        apart = matches_any(module, slow) and module not in loose
        pattern = "/%s/%s/" % (module, group) if apart else "/%s/" % module
        counts[pattern] = counts.get(pattern, 0) + count
    return [Share(pattern, count) for pattern, count in counts.items()]


def longest_first(shares, last):
    """The shares in the order to start them: the longest of last time first.

    `last` holds the seconds each pattern took. A share never timed goes
    first of all, so that a new slow one is not left for the end, where it
    would run alone.
    """
    return sorted(shares, key=lambda share: -last.get(share.pattern, float("inf")))


def last_times():
    """How long each share took last time, in seconds by pattern. Nothing when no run was timed yet."""
    try:
        with open(TIMES_FILE) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return {}


def remember_times(runs):
    """Keep how long each share took, for the order of the next run"""
    times = last_times()
    times.update({run.share.pattern: round(run.seconds, 2) for run in runs})
    try:
        with open(TIMES_FILE, "w") as handle:
            json.dump(times, handle, indent=0, sort_keys=True)
    except OSError:
        pass  # The order of the next run is a convenience only


def run_in_processes(spec, shares, jobs, seed):
    """Run the shares in several processes at once, and give what became of each.

    Each process takes the next share when it is done with one, so the
    load evens out by itself. Each has a temporary folder of its own, so
    that the files of two of them never meet, and nothing is left behind
    after the run.
    """
    waiting = queue.Queue()
    for share in shares:
        waiting.put(share)
    runs = []
    lock = threading.Lock()
    temporary = tempfile.mkdtemp(prefix="haskell-dev-")

    def work(number):
        own = os.path.join(temporary, "process%d" % number)
        os.makedirs(own)
        environment = dict(os.environ, TMPDIR=own)
        while True:
            try:
                share = waiting.get_nowait()
            except queue.Empty:
                return
            run = run_share(spec, share, seed, environment)
            with lock:
                runs.append(run)
                if sys.stdout.isatty():
                    print("\r  %d of %d shares done" % (len(runs), len(shares)), end="", flush=True)

    workers = [threading.Thread(target=work, args=(number,)) for number in range(jobs)]
    try:
        for worker in workers:
            worker.start()
        for worker in workers:
            worker.join()
    finally:
        shutil.rmtree(temporary, ignore_errors=True)
    if sys.stdout.isatty():
        print("\r" + " " * 40 + "\r", end="")
    return runs


def run_share(spec, share, seed, environment):
    """Run one share in a process of its own, and give what became of it"""
    began = time.time()
    ran = subprocess.run(
        [spec, "--seed", str(seed), "--match", share.pattern],
        capture_output=True,
        text=True,
        errors="replace",
        env=environment,
    )
    return Run(share, time.time() - began, ran.returncode, ran.stdout + ran.stderr)


def summary_of(output):
    """The summary line of a run of the test binary, matched, or None when the run ended without one"""
    for line in reversed(output.splitlines()):
        found = SUMMARY_LINE.match(line)
        if found:
            return found
    return None


def report(runs, listed, seconds, jobs, seed):
    """Print the failures, then the totals of the whole run, and give the exit code"""
    examples = failures = pending = 0
    broken = []  # runs that failed, or that ended without a summary
    for run in runs:
        summary = summary_of(run.output)
        if summary:
            examples += int(summary.group(1))
            failures += int(summary.group(2))
            pending += int(summary.group(3) or 0)
        if run.code != 0 or not summary:
            broken.append(run)
    for run in broken:
        print("\n--- %s" % run.share.pattern)
        # The failures come after the listing of the tests that ran
        at = run.output.find("\nFailures:")
        print(run.output[at:].strip() if at >= 0 else run.output.strip())
    slowest = max(runs, key=lambda run: run.seconds)
    print("%d examples, %d failures%s" % (examples, failures, ", %d pending" % pending if pending else ""))
    print(
        "%.0f seconds with %d processes, seed %d. The longest share took %.0f seconds: %s"
        % (seconds, jobs, seed, slowest.seconds, slowest.share.pattern)
    )
    if examples != listed and not broken:
        print(
            "The listing counts %d tests and %d ran: a pattern of this script names its share wrongly"
            % (listed, examples)
        )
        return 1
    if broken:
        print("To run a failure again, as the test binary says: haskell-dev test --seed %d --match PATTERN" % seed)
        return 1
    return 0


if __name__ == "__main__":
    main()
